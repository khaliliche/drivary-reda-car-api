# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit real values
.env
.env.local
.env.development
.env.production
.env.*.local
.env.test
.env.test.local
test-results/
.env*.local
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_ed25519
.ssh/
secrets/
.gcloud/
.aws/
.vercel
vercel.json

# typescript
*.tsbuildinfo
next-env.d.ts

# backups
*.bak*
.walkin-signing-backup/
